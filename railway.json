{
  "$schema": "https://json.schemastore.org/railway.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  },
  "env": {
    "DEBUG": {
      "description": "Enable debug mode",
      "default": "false"
    },
    "SECRET_KEY": {
      "description": "Secret key for JWT and security (generate a random string, min 32 chars)",
      "default": ""
    },
    "CORS_ORIGINS": {
      "description": "Comma-separated list of allowed CORS origins",
      "default": "https://yourdomain.com"
    },
    "S3_ENDPOINT": {
      "description": "S3-compatible endpoint URL",
      "default": "https://s3.amazonaws.com"
    },
    "S3_ACCESS_KEY": {
      "description": "S3 access key",
      "default": ""
    },
    "S3_SECRET_KEY": {
      "description": "S3 secret key",
      "default": ""
    },
    "S3_BUCKET": {
      "description": "S3 bucket name",
      "default": "video-editor"
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-west-2"
    },
    "S3_SECURE": {
      "description": "Use HTTPS for S3 (true for AWS S3/B2, false for local MinIO)",
      "default": "true"
    }
  }
}
