# Backend .env example - Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://video_editor:password123@postgres:5432/video_editor

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-long-!!!

# S3 / Object Storage
# For local development with MinIO:
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-editor
S3_REGION=us-east-1
S3_SECURE=false

# For Railway with AWS S3 or Backblaze B2:
# S3_ENDPOINT=https://s3.amazonaws.com  (for AWS)
# S3_ENDPOINT=https://s3.backblazeb2.com  (for Backblaze B2)
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
# S3_REGION=us-west-2
# S3_SECURE=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Celery (usually same as Redis)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
